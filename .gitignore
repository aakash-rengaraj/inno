# environments
.venv/
__pycache__/
*.pyc
web/node_modules/

# build output — regenerated by `python -m tools.build_web`
web/dist/
web/dist-public/
web/dist-console/

# runtime state — citizen reports and officer actions, not source
server/data/

.DS_Store

# Committed on purpose, because the demo path reads them and must never
# regenerate them mid-demo:
#   data/raw/**               scrape output (currently synthetic fixtures)
#   data/processed/*.parquet  the shared observation table
#   web/public/data/*.json    built artifacts the static fallback serves

# editor/agent tooling config
.claude/
