# Reverse proxy for inno.aakashr.com -> the app on localhost:8000.
#
# Caddy is here for two reasons. Cloudflare's proxy does not support port 8000
# (proxied HTTP is 80, 8080, 8880, 2052, 2082, 2086, 2095), so the app cannot be
# orange-clouded where it stands. And the console passphrase travels in the
# X-Console-Token header, which over plain HTTP is readable in transit.
#
# Caddy obtains and renews a real Let's Encrypt certificate on its own. Nothing
# to schedule and no cert files to copy.

inno.aakashr.com {
	reverse_proxy 127.0.0.1:8000 {
		# The app sees Cloudflare's IP otherwise, so the per-IP rate limit on
		# POST /api/reports would throttle every reporter as if they were one.
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
	}

	encode gzip

	log {
		output file C:/apps/innohack/logs/caddy.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
